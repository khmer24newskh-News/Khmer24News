# ---------------------------------------------------------------------------
# TEMPLATE. run.bat copies this to .env on first launch.
#
# Once copied, .env is the one file that holds your real bot token:
#   - .env is listed in .gitignore. Never commit it, never share it.
#   - THIS file (.env.example) must only ever contain placeholders.
#   - If a real token ever ends up in this file, revoke it: @BotFather /revoke
# ---------------------------------------------------------------------------

# From @BotFather. Replace the placeholder below with your real token.
TELEGRAM_BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE
# Your chat id. For a group it looks like -1001234567890 (keep the minus sign).
# Find it by messaging @userinfobot, or run:  .venv\Scripts\python.exe send_daily.py --check
TELEGRAM_CHAT_ID=PUT_YOUR_CHAT_ID_HERE

# --- web server ---
# Keep this on 127.0.0.1. Only change it if you understand that the dashboard
# has no login; see README "Exposing it on the network".
APP_URL=http://127.0.0.1:5000
PORT=5000
HOST=127.0.0.1
# Optional: if HOST is not 127.0.0.1, set an API token to protect /api/articles.
API_TOKEN=

# --- storage ---
DB_PATH=khmer24_bi.db

# --- collection tuning ---
# Only articles published within this window are kept and reported. This is what
# makes the report "daily". Raise it to backfill, lower it to stay strict.
# 72 gives ~3 days of slack if the machine is off for a couple of days.
LOOKBACK_HOURS=72
MAX_ITEMS_PER_SOURCE=15
# Resolving a Google News link to the real article URL costs 2 HTTP requests,
# so it is capped per run. Unresolved links fall back to the Google redirect.
MAX_RESOLVES_PER_RUN=40
REQUEST_TIMEOUT=20
# Pause in seconds between sources, to be polite to Google and avoid throttling.
POLITE_DELAY=1.0

# --- advanced (leave as-is unless you know why) ---
# Leave at 0. Google's RSS <summary> is not article text - it repeats the
# headline including the publisher name, which mis-classifies stories.
CLASSIFY_WITH_SUMMARY=0
# Sensitivity of near-duplicate detection (0-1). Lower = stricter = fewer merges.
DUP_OVERLAP=0.5

# --- security ---
# Set to any long random string. Keeps CSRF tokens valid across restarts.
# Leave empty and a random one is generated at each start (fine for local use).
SECRET_KEY=
# --- streaming alerts: send each article as its source publishes it ---
# 1 = on. The scheduled alert job runs this; the 07:30 job still sends the digest.
STREAM_ALERTS=1
# Articles per alert message.
ALERT_BATCH_SIZE=3
# Cap per run. Anything above this waits for the next run, so one source
# bulk-uploading cannot flood your chat.
ALERT_MAX_PER_TICK=20
# --- cloud Worker (this machine fetches, the cloud sends) ---
# Google News returns 503 to Cloudflare, so discovery stays local and this
# pushes the result up for the Worker to classify, alert and send.
# See worker/DISCOVERY-NOTES.md.
CLOUD_WORKER_URL=https://khmer24news.khmer24newskh.workers.dev
