node_modules/
dist/
.wrangler/

# Local dev secrets. Real values are set with `wrangler secret put`, which
# stores them encrypted in Cloudflare and never writes them to disk.
#
# The negation is not optional: `.dev.vars.*` also matches `.dev.vars.example`,
# so without it the template that documents this file is silently excluded too.
.dev.vars
.dev.vars.*
!.dev.vars.example

# ~600 KB of scraped Google News markup used as test input. Not committed:
# it is large, third-party content, and goes stale. `npm test` downloads it
# automatically on first run.
test/fixtures/

*.log
